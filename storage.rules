rules_version = '2';

// Only the owner can upload or delete files. Anyone can view them.
service firebase.storage {
  match /b/{bucket}/o {

    // ⚠️ Replace with your own user ID (the same one as in firestore.rules).
    function isOwner() {
      return request.auth != null && request.auth.uid == 'REPLACE_WITH_YOUR_UID';
    }

    match /uploads/{file=**} {
      allow read: if true;
      allow create, update: if isOwner()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
      allow delete: if isOwner();
    }

    match /{other=**} {
      allow read, write: if false;
    }
  }
}
