rules_version = '2';

// These rules are what really protects the site. Hiding buttons in the page is
// only cosmetic; Firebase checks every read and write against the rules below.
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Replace with your own user ID. The site shows it after you sign in once.
    function isOwner() {
      return request.auth != null && request.auth.uid == 'xfSAbQUoHbSutKnGVrLOVHvJONx1';
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function itemPublished(itemId) {
      return get(/databases/$(database)/documents/items/$(itemId)).data.published == true;
    }

    // Profile (name, bio, avatar): everyone can read it, only the owner can change it.
    match /site/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Projects, notes, blog posts and photos. Drafts are visible only to the owner.
    match /items/{itemId} {
      allow read: if isOwner() || resource.data.published == true;
      allow write: if isOwner();

      // Public comments: anyone can read and add comments on published items.
      // Nobody can edit a comment; only the owner can delete one.
      match /comments/{commentId} {
        allow read: if isOwner() || itemPublished(itemId);
        allow create: if (isOwner() || itemPublished(itemId))
          && request.resource.data.keys().hasOnly(['name', 'text', 'owner', 'createdAt'])
          && str(request.resource.data.name, 1, 60)
          && str(request.resource.data.text, 1, 2000)
          && request.resource.data.createdAt == request.time
          && (request.resource.data.get('owner', false) == false || isOwner());
        allow update: if false;
        allow delete: if isOwner();
      }
    }

    // Uploaded images (compressed, stored as data URLs). Anyone can view them;
    // only the owner can add or delete. A document is capped at 1 MiB.
    match /images/{imageId} {
      allow read: if true;
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['data', 'createdAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
      allow update: if false;
      allow delete: if isOwner();
    }

    // Two-way chats. A chat's id is long and random and works like a private
    // link: the visitor's browser keeps it. Nobody can list chats except the
    // owner, so a chat can only be opened by someone who has its id.
    match /threads/{threadId} {
      allow get: if true;
      allow list: if isOwner();
      allow create: if threadId.size() >= 20
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt', 'lastAt', 'lastText', 'lastFrom', 'unreadOwner', 'unreadGuest'])
        && str(request.resource.data.name, 1, 80)
        && str(request.resource.data.email, 0, 120)
        && request.resource.data.lastText == ''
        && request.resource.data.lastFrom == 'guest'
        && request.resource.data.unreadOwner == false
        && request.resource.data.unreadGuest == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastAt == request.time;
      allow update: if isOwner()
        // the visitor sent a message
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt', 'lastText', 'lastFrom', 'unreadOwner'])
            && request.resource.data.lastFrom == 'guest'
            && request.resource.data.unreadOwner == true
            && request.resource.data.lastAt == request.time
            && str(request.resource.data.lastText, 0, 120))
        // the visitor read the owner's reply
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadGuest'])
            && request.resource.data.unreadGuest == false);
      allow delete: if isOwner();

      match /msgs/{msgId} {
        allow read: if true;
        allow create: if exists(/databases/$(database)/documents/threads/$(threadId))
          && request.resource.data.keys().hasOnly(['from', 'text', 'image', 'sticker', 'createdAt'])
          && ((isOwner() && request.resource.data.from == 'owner') || (!isOwner() && request.resource.data.from == 'guest'))
          && str(request.resource.data.text, 0, 4000)
          && str(request.resource.data.image, 0, 360000)
          && str(request.resource.data.sticker, 0, 24)
          && (request.resource.data.text.size() > 0 || request.resource.data.image.size() > 0 || request.resource.data.sticker.size() > 0)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner();
      }
    }

    // Older one-way messages: anyone can send one, only the owner can read them.
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'text', 'read', 'createdAt'])
        && str(request.resource.data.name, 1, 80)
        && str(request.resource.data.email, 0, 120)
        && str(request.resource.data.text, 1, 5000)
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isOwner();
    }
  }
}
